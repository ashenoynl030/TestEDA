# =============================================================================
# EDA Tracker — Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your Azure AD values.
# NEVER commit the .env file — it is listed in .gitignore.
#
# To register an Azure AD app:
#   1. Go to Azure Portal → App registrations → New registration
#   2. Name: "EDA Tracker API"
#   3. Supported account types: "Accounts in this organizational directory only"
#   4. No redirect URI needed (backend-only client credentials flow)
#   5. After creation, go to Certificates & secrets → New client secret
#   6. Go to API permissions → Add:
#      - Microsoft Graph → Application permissions → Sites.Read.All
#      - Microsoft Graph → Application permissions → Files.Read.All
#   7. Click "Grant admin consent" for the permissions
#
# =============================================================================

# Azure AD tenant ID (found in Azure Portal → Azure Active Directory → Overview)
AZURE_TENANT_ID=

# Application (client) ID from your app registration
AZURE_CLIENT_ID=

# Client secret value (NOT the secret ID — the actual value string)
AZURE_CLIENT_SECRET=

# Server port (default: 3001)
PORT=3001

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:5173
